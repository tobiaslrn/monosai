{
  "name": "monosai",
  "version": "0.1.0",
  "description": "Local-first Japanese reading application for learners.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiaslrn/monosai.git"
  },
  "homepage": "https://github.com/tobiaslrn/monosai#readme",
  "bugs": {
    "url": "https://github.com/tobiaslrn/monosai/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration pages --stats-json",
    "build:e2e": "ng build --configuration e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run assets:verify && npm run fixtures:verify && npm run test && npm run build",
    "assets:build": "node scripts/assets/build-language-assets.mjs",
    "assets:verify": "node scripts/assets/verify-language-assets.mjs",
    "fixtures:build": "node scripts/fixtures/build-anki-fixtures.mjs",
    "fixtures:verify": "node scripts/fixtures/build-anki-fixtures.mjs --check",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "icons:verify": "node scripts/icons/verify-icons.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "report-bundle": "node scripts/report-bundle.mjs",
    "report-bundle:check": "node scripts/report-bundle.mjs --check",
    "serve-dist": "node scripts/serve-dist.mjs",
    "licenses:build": "node scripts/licenses/check-licenses.mjs",
    "licenses:check": "node scripts/licenses/check-licenses.mjs --check",
    "test:manual": "vitest run --config vitest.manual.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@lucide/angular": "^1.33.0",
    "@openrouter/sdk": "^1.2.54",
    "dexie": "^4.4.5",
    "fzstd": "^0.1.1",
    "lindera-wasm-web-ipadic": "2.0.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.2",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
