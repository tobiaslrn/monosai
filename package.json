{
  "name": "monosai",
  "version": "0.1.0",
  "description": "Local-first Japanese reading application for learners.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiaslrn/monosai.git"
  },
  "homepage": "https://github.com/tobiaslrn/monosai#readme",
  "bugs": {
    "url": "https://github.com/tobiaslrn/monosai/issues"
  },
  "scripts": {
    "ng": "npm --prefix web run ng --",
    "start": "npm --prefix web run start",
    "build": "npm --prefix web run build",
    "build:pages": "npm --prefix web run build:pages --",
    "watch": "npm --prefix web run watch",
    "test": "npm --prefix web run test",
    "test:coverage": "npm --prefix web run test:coverage",
    "typecheck": "npm --prefix web run typecheck",
    "typecheck:app": "npm --prefix web run typecheck:app",
    "typecheck:e2e": "npm --prefix web run typecheck:e2e",
    "lint": "npm --prefix web run lint",
    "format": "node web/node_modules/prettier/bin/prettier.cjs --config web/.prettierrc --write .",
    "format:check": "node web/node_modules/prettier/bin/prettier.cjs --config web/.prettierrc --check .",
    "e2e": "npm --prefix web run e2e --",
    "e2e:full": "npm --prefix web run e2e:full --",
    "e2e:pwa": "npm --prefix web run e2e:pwa",
    "verify": "npm run verify:static && npm run test:coverage && npm run verify:build && npm run bridge:verify",
    "bridge:verify": "node scripts/bridge/icons.mjs --check && node --test scripts/bridge/release-version.test.mjs && node scripts/bridge/verify.mjs",
    "verify:static": "npm --prefix web run verify:static && npm run docs:verify && npm run licenses:check",
    "verify:build": "npm --prefix web run verify:build --",
    "dist:fallback": "npm --prefix web run dist:fallback",
    "assets:build": "npm --prefix web run assets:build",
    "assets:verify": "npm --prefix web run assets:verify",
    "fixtures:build": "npm --prefix web run fixtures:build",
    "fixtures:verify": "npm --prefix web run fixtures:verify",
    "icons:build": "npm --prefix web run icons:build",
    "icons:verify": "npm --prefix web run icons:verify",
    "docs:verify": "node scripts/docs/verify-decision-index.mjs",
    "verify-dist": "npm --prefix web run verify-dist",
    "report-bundle": "npm --prefix web run report-bundle",
    "report-bundle:check": "npm --prefix web run report-bundle:check",
    "serve-dist": "npm --prefix web run serve-dist",
    "licenses:build": "node scripts/licenses/check-licenses.mjs",
    "licenses:check": "node scripts/licenses/check-licenses.mjs --check",
    "test:manual": "npm --prefix web run test:manual"
  }
}
