{
  "name": "monosai",
  "version": "0.1.0",
  "description": "Local-first Japanese reading application for learners.",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiaslrn/monosai.git"
  },
  "homepage": "https://github.com/tobiaslrn/monosai#readme",
  "bugs": {
    "url": "https://github.com/tobiaslrn/monosai/issues"
  },
  "scripts": {
    "start": "npm --prefix apps/web run start --",
    "worktree:setup": "node apps/web/scripts/worktree-setup.mjs",
    "build": "npm --prefix apps/web run build",
    "build:pages": "npm --prefix apps/web run build:pages --",
    "test": "npm --prefix apps/web run test --",
    "test:coverage": "npm --prefix apps/web run test:coverage",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "format": "node apps/web/node_modules/prettier/bin/prettier.cjs --config apps/web/.prettierrc --write .",
    "format:check": "node apps/web/node_modules/prettier/bin/prettier.cjs --config apps/web/.prettierrc --check .",
    "e2e": "npm --prefix apps/web run e2e --",
    "e2e:full": "npm --prefix apps/web run e2e:full --",
    "e2e:pwa": "npm --prefix apps/web run e2e:pwa",
    "verify": "npm run verify:static && npm run test:coverage && npm run verify:build && npm run bridge:verify",
    "bridge:verify": "node scripts/bridge/icons.mjs --check && node --test scripts/bridge/release-version.test.mjs scripts/bridge/jdk.test.mjs && node scripts/bridge/release-version.mjs && node scripts/bridge/verify.mjs",
    "bridge:icons": "node scripts/bridge/icons.mjs",
    "verify:static": "npm --prefix apps/web run verify:static && npm run docs:verify && npm run licenses:check",
    "verify:build": "npm --prefix apps/web run verify:build --",
    "dist:fallback": "npm --prefix apps/web run dist:fallback",
    "assets:build": "npm --prefix apps/web run assets:build",
    "assets:verify": "npm --prefix apps/web run assets:verify",
    "fixtures:build": "npm --prefix apps/web run fixtures:build",
    "fixtures:verify": "npm --prefix apps/web run fixtures:verify",
    "icons:build": "npm --prefix apps/web run icons:build",
    "icons:verify": "npm --prefix apps/web run icons:verify",
    "docs:verify": "node scripts/docs/verify-decision-index.mjs",
    "verify-dist": "npm --prefix apps/web run verify-dist",
    "report-bundle:check": "npm --prefix apps/web run report-bundle:check",
    "licenses:build": "node scripts/licenses/check-licenses.mjs",
    "licenses:check": "node scripts/licenses/check-licenses.mjs --check",
    "test:manual": "npm --prefix apps/web run test:manual"
  }
}
