<?xml version="1.0" encoding="utf-8"?>
<!-- A text input keeps its visible boundary: an empty borderless input reads as nothing at all. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_raised" />
    <stroke android:width="@dimen/border_control" android:color="@color/border_strong" />
    <corners android:radius="@dimen/radius_control" />
    <padding android:left="@dimen/space_3" android:top="@dimen/space_3"
        android:right="@dimen/space_3" android:bottom="@dimen/space_3" />
</shape>
