<?xml version="1.0" encoding="utf-8"?>
<!--
  The one filled action of a surface. Disabled is the sunken surface with its own
  boundary, never opacity: a faded fill is not recognisable as disabled in both themes.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_sunken" />
                    <stroke android:width="@dimen/border_control" android:color="@color/border_subtle" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/action_primary" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
