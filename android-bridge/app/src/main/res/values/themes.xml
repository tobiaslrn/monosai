<resources>
    <style name="Theme.MonosaiBridge.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/bridge_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bridge_foreground</item>
        <item name="android:colorAccent">@color/bridge_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.MonosaiBridge.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/bridge_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bridge_foreground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
