<?xml version="1.0" encoding="utf-8"?>
<!--
  One control silhouette and one text scale, matching docs/design-system.md.
  The screen carries a single heading rank: its cards are rows whose labels say
  what they are, so a section or group title would name what is already in front
  of the reader. Every size is sp, so the device's font-size setting moves the
  whole screen.
-->
<resources>
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- The screen's one title. -->
    <style name="Text.PageTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Status">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
    </style>

    <!--
      One pill silhouette, one touch-target height, one text size and weight for
      every text button; only fill and border say which kind it is.
    -->
    <style name="Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <style name="Button.Ghost">
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@color/button_ghost_text</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/field_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">top|start</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Switch">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- The thumb stays the raised surface in both states, or a selected
             switch would be one flat action-coloured lozenge. -->
        <item name="android:thumbTint">@color/surface_raised</item>
        <item name="android:trackTint">@color/switch_track</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
    </style>

    <!--
      The screen's one repeating shape: a label on the left, and its current
      value or its one control on the right, on a single line.
    -->
    <style name="Row">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="Text.Value">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">end</item>
    </style>

    <!-- One card: the page's only raised surface, with one inner padding. -->
    <style name="Card">
        <item name="android:background">@drawable/surface_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:elevation">1dp</item>
        <item name="android:outlineAmbientShadowColor">@color/shadow_raised</item>
        <item name="android:outlineSpotShadowColor">@color/shadow_raised</item>
    </style>
</resources>
