{
  "name": "monosai",
  "version": "0.1.0",
  "description": "Local-first Japanese reading application for learners.",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiaslrn/monosai.git"
  },
  "homepage": "https://github.com/tobiaslrn/monosai#readme",
  "bugs": {
    "url": "https://github.com/tobiaslrn/monosai/issues"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "ng build",
    "build:pages": "ng build --configuration pages --stats-json",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "typecheck": "npm run typecheck:app && npm run typecheck:e2e",
    "typecheck:app": "tsc -b tsconfig.json --pretty false",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --pretty false && tsc -p e2e-pwa/tsconfig.json --pretty false",
    "lint": "eslint .",
    "stylelint": "node scripts/stylelint-components.mjs",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:full": "playwright test --config=playwright.full.config.ts",
    "e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "verify:static": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run assets:verify && npm run fixtures:verify && npm run icons:verify && npm run scripts:test",
    "scripts:test": "node --test scripts/worktree-ports.test.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "verify:build": "npm run build:pages && npm run dist:fallback && npm run verify-dist",
    "dist:fallback": "node scripts/dist-fallback.mjs",
    "assets:build": "node scripts/assets/build-language-assets.mjs",
    "assets:verify": "node scripts/assets/verify-language-assets.mjs",
    "fixtures:build": "node scripts/fixtures/build-anki-fixtures.mjs",
    "fixtures:verify": "node scripts/fixtures/build-anki-fixtures.mjs --check",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "icons:verify": "node scripts/icons/verify-icons.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "report-bundle": "node scripts/report-bundle.mjs",
    "report-bundle:check": "node scripts/report-bundle.mjs --check",
    "serve-dist": "node scripts/serve-dist.mjs",
    "test:manual": "vitest run --config vitest.manual.config.ts"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@lucide/angular": "^1.63.0",
    "@openrouter/sdk": "^1.5.15",
    "dexie": "^4.4.7",
    "fzstd": "^0.1.1",
    "lindera-wasm-web-ipadic": "2.0.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.15.2",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
