{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "icons",
      "installMode": "prefetch",
      "resources": {
        "files": ["/icons/*.png"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|png|webp|woff2)",
          "!/assets/language/**",
          "!/assets/sqlite/**",
          "!/icons/**"
        ]
      }
    }
  ],
  "navigationUrls": ["!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/assets/**"]
}
