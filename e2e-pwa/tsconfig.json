{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Type-checked only: Playwright transpiles the specs itself and nothing
       consumes a build of this project, so it declares no output root. */
    "noEmit": true,
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts", "../playwright.pwa.config.ts"]
}
